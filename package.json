{
  "name": "deccan-origin-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Deccan Origin Monorepo Workspace - Organic Agriculture, Escrow & IoT Logistics Platform",
  "scripts": {
    "start": "node scripts/start-all.js",
    "start:web": "node scripts/start-all.js",
    "start:all": "node scripts/start-all.js",
    "web": "node scripts/start-all.js",
    "android": "npm run android --prefix Frontend",
    "ios": "npm run ios --prefix Frontend",
    "lint": "npm run lint --prefix Frontend",
    "server": "npm start --prefix Backend",
    "dev:backend": "npm run dev --prefix Backend",
    "test": "npm test --prefix Backend",
    "test:all": "npm run test:all --prefix Backend",
    "start:frontend": "npm start --prefix Frontend",
    "start:backend": "npm start --prefix Backend",
    "expo": "npm start --prefix Frontend",
    "expo:clear": "npx expo start -c --prefix Frontend"
  },
  "workspaces": [
    "Frontend",
    "Backend"
  ]
}
